{
  "ci": {
    "collect": {
      "staticDistDir": "out",
      "isSinglePageApplication": true,
      "numberOfRuns": 1,
      "settings": {
        "budgets": [
          {
            "path": "/*",
            "timings": [
              { "metric": "interactive", "budget": 5000 },
              { "metric": "first-contentful-paint", "budget": 2000 },
              { "metric": "largest-contentful-paint", "budget": 3000 },
              { "metric": "total-blocking-time", "budget": 200 }
            ],
            "resourceSizes": [
              { "resourceType": "total", "budget": 400 },
              { "resourceType": "script", "budget": 200 },
              { "resourceType": "image", "budget": 450 },
              { "resourceType": "document", "budget": 50 },
              { "resourceType": "third-party", "budget": 60 }
            ],
            "resourceCounts": [
              { "resourceType": "total", "budget": 60 },
              { "resourceType": "script", "budget": 8 },
              { "resourceType": "image", "budget": 12 },
              { "resourceType": "font", "budget": 3 }
            ]
          }
        ],
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.80}],
        "categories:accessibility": ["warn", {"minScore": 0.90}],
        "categories:best-practices": ["warn", {"minScore": 0.95}],
        "categories:seo": ["warn", {"minScore": 0.80}]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse/reports/mobile" }
  }
}
